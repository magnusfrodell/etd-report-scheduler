msgstr "Alla tenants · {period_label}"

#, python-brace-format
msgid ""
"Analysts released {to_neutral} message(s) as neutral (possible false positives) and escalated {to_threat} to a threat"
" verdict (possible false negatives)."
msgstr ""
"Analytiker släppte {to_neutral} meddelande(n) med bedömningen neutral (möjliga falska positiva) och uppgraderade "
"{to_threat} till en hotbedömning (möjliga falska negativa)."

