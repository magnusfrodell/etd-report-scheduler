# ---- Required ---------------------------------------------------------------
# Signs the admin session cookie. Any long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts tenant credentials and the SMTP password at rest. Generate ONCE and
# back it up together with the data volume - without it stored secrets are lost.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Password for the built-in admin user (username: admin, override with ADMIN_USERNAME).
ADMIN_PASSWORD=

# ---- Optional ---------------------------------------------------------------
# ADMIN_USERNAME=admin
# DATA_DIR=/data                                  # inside the container; leave as is
# DATABASE_URL=postgresql+psycopg://etd:etd@db:5432/etd   # default: SQLite in DATA_DIR
# LOG_LEVEL=INFO
# HTTP_TIMEOUT=30
# SCHEDULER_ENABLED=true                          # false = UI only, nothing runs automatically
# SESSION_MAX_AGE_SECONDS=43200
# COOKIE_SECURE=false                             # true when served behind HTTPS
